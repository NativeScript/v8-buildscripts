+TEST(DeclinedInterceptorStoreRepresentations) {
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  SetUpDeclinedStoreTest(isolate, env.local());
+  RunDeclinedStoreScript(isolate, R"(
+    function overwrite(name, init, warm_value, values, all_fast = false) {
+      return compare(name, ({set}) => {
+        const shape = () => make({['r_' + name]: 0, x: init});
+        warm(set, shape, warm_value);
+        const o = shape();
+        const sibling = shape();
+        const paths = values.map(v => set(o, v));
+        if (all_fast) for (const path of paths) expectPath(path, 'fast');
+        check(Object.is(o.x, values[values.length - 1]), 'value');
+        return desc(o) + ' ' + desc(sibling);
+      });
+    }
+    overwrite('smi', 0, i => i, [1, 2, -3], true);
+    overwrite('double', 1.5, i => i + 0.5, [2.5, 3, -0, NaN, 1e300], true);
+    overwrite('smi to double', 0, i => i, [1, 1.5, 2, 2.5]);
+    overwrite('smi to tagged', 0, i => i, [1, 'str', 2, {}]);
+    overwrite('double to tagged', 1.5, i => i + 0.5, [2.5, 'str', 3.5]);
+    overwrite('heap object field type', {a: 0}, i => ({a: i}),
+              [{a: 7}, {b: 1}, {a: 8}, 'str', 3]);
+    overwrite('tagged', 'str', i => i % 2 ? 'odd' : 1.5,
+              ['s', 1, 2.5, {}, undefined, null], true);
+  )");
+}
