+TEST(DeclinedInterceptorStoreGCInSetter) {
+  v8::Isolate* isolate = CcTest::isolate();
+  i::ManualGCScope manual_gc_scope;
+  i::heap::ManualEvacuationCandidatesSelectionScope selection_scope(
+      manual_gc_scope);
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  SetUpDeclinedStoreTest(isolate, env.local());
+  // The setter moves the receiver, its property array and mutable heap
+  // number boxes before declining.
+  RunDeclinedStoreScript(isolate, R"(
+    for (const kind of ['minor', 'major', 'compact']) {
+      for (const [type, init, value] of [['smi', 0, i => i],
+                                         ['double', 0.5, i => i + 0.5],
+                                         ['tagged', 'a', i => 'v' + i]]) {
+        compare('gc ' + kind + ' ' + type, ({set}) => {
+          const shape = () => make({['g_' + kind + type]: init, x: init});
+          warm(set, shape, value);
+          const o = shape();
+          const sibling = shape();
+          onSet = (holder, n, v) => { if (holder === o) gc(holder, kind); };
+          for (let i = 100; i < 104; i++) expectPath(set(o, value(i)), 'fast');
+          onSet = undefined;
+          check(o.x === value(103) && sibling.x === init, 'values');
+          return desc(o) + ' ' + desc(sibling);
+        });
+      }
+    }
+  )");
