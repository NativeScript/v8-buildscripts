+TEST(DeclinedInterceptorStoreOverwrite) {
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  SetUpDeclinedStoreTest(isolate, env.local());
+  RunDeclinedStoreScript(isolate, R"(
+    compare('monomorphic out-of-object', ({set}) => {
+      const shape = () => make({w: 0, x: 0});
+      warm(set, shape);
+      const o = shape();
+      check(!isInobject(o, 'x'), 'out-of-object');
+      for (let i = 0; i < 20; i++) expectPath(set(o, i), 'fast');
+      check(o.x === 19, 'value');
+      return desc(o);
+    });
+    compare('monomorphic in-object', ({set}) => {
+      const shape = () => new S();
+      warm(set, shape);
+      const o = shape();
+      check(isInobject(o, 'x'), 'in-object');
+      for (let i = 0; i < 20; i++) expectPath(set(o, i), 'fast');
+      check(o.x === 19, 'value');
+      return desc(o);
+    });
+    compare('polymorphic', ({set}) => {
+      const shapes = [() => make({p1: 0, x: 0}), () => make({p2: 0, x: 0}),
+                      () => make({p3: 0, p4: 0, x: 0})];
+      for (let i = 0; i < 12; i++) for (const shape of shapes) set(shape(), i);
+      const objects = shapes.map(shape => shape());
+      for (let i = 0; i < 20; i++) {
+        for (const o of objects) expectPath(set(o, i), 'fast');
+      }
+      return objects.map(desc).join(' ');
+    });
+    compare('megamorphic', ({set}) => {
+      const shapes = [];
+      for (let j = 0; j < 8; j++) shapes.push(() => make({['m' + j]: 0, x: 0}));
+      for (let i = 0; i < 12; i++) for (const shape of shapes) set(shape(), i);
+      const objects = shapes.map(shape => shape());
+      // Megamorphic stub cache collisions can turn a store into a miss.
+      let checked = 0, fast = 0;
+      for (let i = 0; i < 20; i++) {
+        for (const o of objects) {
+          const path = set(o, i);
+          if (path === 'n/a') continue;
+          checked++;
+          if (path === 'fast') fast++;
+        }
+      }
+      check(fastPathEnabled() ? gcStress() || fast * 2 >= checked : fast === 0,
+            fast + ' of ' + checked + ' megamorphic stores were fast');
+      return objects.map(desc).join(' ');
+    });
+    for (const tier of ['maglev', 'turbofan']) {
+      compare('optimized ' + tier, ({set, store_site, mode}) => {
+        const shape = () => make({['t_' + tier]: 0, x: 0});
+        warm(set, shape);
+        if (mode === 'ic') {
+          %PrepareFunctionForOptimization(store_site);
+          set(shape(), 0);
+          if (tier === 'maglev') {
+            %OptimizeMaglevOnNextCall(store_site);
+          } else {
+            %OptimizeFunctionOnNextCall(store_site);
+          }
+        }
+        const o = shape();
+        for (let i = 0; i < 10; i++) expectPath(set(o, i), 'fast');
+        if (mode === 'ic' && useIC()) {
+          const enabled =
+              tier === 'maglev' ? %IsMaglevEnabled() : %IsTurbofanEnabled();
+          const active = tier === 'maglev' ? %ActiveTierIsMaglev(store_site)
+                                           : %ActiveTierIsTurbofan(store_site);
+          check(active === enabled, tier + ' code');
+        }
+        expectPath(set(o, 'str'), 'runtime');
+        for (let i = 0; i < 10; i++) expectPath(set(o, i), 'fast');
+        return desc(o);
+      });
+    }
+    compare('keyed store with a constant name', ({kset}) => {
+      const shape = () => make({k1: 0, x: 0});
+      warm(kset, shape);
+      const o = shape();
+      for (let i = 0; i < 20; i++) expectPath(kset(o, i), 'fast');
+      return desc(o);
+    });
+  )");
+}
