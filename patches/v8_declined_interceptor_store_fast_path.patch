+// Returns the descriptor of the own writable data field that a store to
+// {lookup}'s receiver writes after a masking interceptor's setter declines,
+// if the store handler can overwrite it in place without a runtime call.
+// UpdateCaches() runs before the setter is called, so this must not have side
+// effects (e.g. no LookupIterator::PrepareForDataProperty()).
+InternalIndex FindOwnFieldPastInterceptor(Isolate* isolate,
+                                          LookupIterator* lookup,
+                                          DirectHandle<Map> receiver_map) {
+  if (!v8_flags.store_ic_declined_interceptor_fast_path) {
+    return InternalIndex::NotFound();
+  }
+  DirectHandle<JSAny> receiver = lookup->GetReceiver();
+  if (lookup->IsElement() || !IsJSObject(*receiver) ||
+      Cast<JSObject>(*receiver)->map() != *receiver_map ||
+      receiver_map->is_dictionary_map() || receiver_map->is_deprecated() ||
+      receiver_map->is_access_check_needed() ||
+      IsJSGlobalProxyMap(*receiver_map) || IsJSGlobalObjectMap(*receiver_map)) {
+    return InternalIndex::NotFound();
+  }
+  DirectHandle<Name> name = lookup->GetName();
+  // The handler does not update protectors.
+  if (ReadOnlyRoots(isolate).IsNameForProtector(*name)) {
+    return InternalIndex::NotFound();
+  }
+  DirectHandle<JSObject> object = Cast<JSObject>(receiver);
+  LookupIterator it(isolate, object, name, object,
+                    LookupIterator::OWN_SKIP_INTERCEPTOR);
+  if (it.state() != LookupIterator::DATA || !it.HolderIsReceiver()) {
+    return InternalIndex::NotFound();
+  }
+  PropertyDetails details = it.property_details();
+  if (details.kind() != PropertyKind::kData ||
+      details.location() != PropertyLocation::kField || details.IsReadOnly()) {
+    return InternalIndex::NotFound();
+  }
+  return it.descriptor_number();
+}
