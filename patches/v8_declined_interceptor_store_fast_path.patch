+TEST(DeclinedInterceptorStoreGlobalProxy) {
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  Local<ObjectTemplate> global_template = ObjectTemplate::New(isolate);
+  v8::NamedPropertyHandlerConfiguration conf(nullptr, DeclinedStoreSetter);
+  global_template->SetHandler(conf);
+  LocalContext env(nullptr, global_template);
+  SetUpDeclinedStoreTest(isolate, env.local());
+  RunDeclinedStoreScript(isolate, R"(
+    var x = 0;
+    function sloppyContextual(v) { x = v; }
+    function strictContextual(v) { 'use strict'; x = v; }
+    compare('global proxy', ({set, sset}) => {
+      const values = [];
+      for (let i = 0; i < 20; i++) {
+        const sloppy_path = set(globalThis, i);
+        values.push(x);
+        const strict_path = sset(globalThis, i + 100);
+        values.push(x);
+        if (i > 10) {
+          expectPath(sloppy_path, 'runtime');
+          expectPath(strict_path, 'runtime');
+        }
+      }
+      return values.join(',');
+    });
+    for (let i = 0; i < 20; i++) {
+      let before = calls();
+      sloppyContextual(i);
+      check(x === i && calls() - before === 1,
+            'sloppy contextual ' + (calls() - before));
+      before = calls();
+      strictContextual(i + 100);
+      check(x === i + 100 && calls() - before === 0,
+            'strict contextual ' + (calls() - before));
+    }
+  )");
+}
