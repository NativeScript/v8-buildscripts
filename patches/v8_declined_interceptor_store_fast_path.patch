+TEST(DeclinedInterceptorStoreConstness) {
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  SetUpDeclinedStoreTest(isolate, env.local());
+  RunDeclinedStoreScript(isolate, R"(
+    compare('const field', ({set}) => {
+      const shape = () => make({c1: 0, x: 0});
+      // Any overwrite makes the field mutable, so the IC is warmed up with
+      // stores that the setter aborts.
+      onSet = (holder, n, v) => { if (v === -1) throw 'abort'; };
+      warm(set, shape, i => -1);
+      onSet = undefined;
+      const o = shape();
+      expectPath(set(o, 1), 'runtime');
+      for (let i = 2; i < 20; i++) expectPath(set(o, i), 'fast');
+      return desc(o);
+    });
+  )");
+}
