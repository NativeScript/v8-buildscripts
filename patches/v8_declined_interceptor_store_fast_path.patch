+v8::Intercepted DeclinedStoreSetter(
+    Local<Name> name, Local<Value> value,
+    const v8::PropertyCallbackInfo<Boolean>& info) {
+  declined_store_setter_calls++;
+  v8::Isolate* isolate = info.GetIsolate();
+  i::StackFrameIterator frames(reinterpret_cast<i::Isolate*>(isolate));
+  bool called_from_handler =
+      !frames.done() &&
+      frames.frame()->type() == i::StackFrame::API_NAMED_ACCESSOR_EXIT;
+  Local<Context> context = isolate->GetCurrentContext();
+  Local<Value> hook;
+  if (!context->Global()->Get(context, v8_str("onSet")).ToLocal(&hook)) {
+    return v8::Intercepted::kYes;
+  }
+  if (hook->IsFunction()) {
+    Local<Value> args[] = {info.Holder(), name, value};
+    if (hook.As<Function>()
+            ->Call(context, v8::Undefined(isolate), arraysize(args), args)
+            .IsEmpty()) {
+      return v8::Intercepted::kYes;
