+  // Runs {effect} from inside the setter on the store of 100 to {o}, with
+  // the store site already warmed up for {o}'s map.
+  function withEffect(name, effect, opts = {}) {
+    return compare(name, (s) => {
+      const keys = opts.keys || {['w_' + name]: 0, x: 0};
+      const shape = () => make(keys);
+      const store = opts.strict ? s.sset : s.set;
+      warm(store, shape);
+      const o = shape();
+      const sibling = shape();
+      store(o, 1);
+      // Setter calls made by the effect itself (nested stores, and
+      // Object.defineProperty, which also calls the setter) are not part of
+      // the store under test.
+      let busy = false;
+      let effect_calls = 0;
+      onSet = (holder, n, v) => {
+        if (v !== 100 || busy) return;
+        busy = true;
+        const before = calls();
+        try {
+          effect(holder, sibling);
+        } finally {
+          effect_calls = calls() - before;
+          busy = false;
+        }
+      };
+      const before = calls();
+      const p100 = store(o, 100, undefined);
+      check(calls() - before === 1 + effect_calls,
+            name + ': setter called ' + (calls() - before) + ' times');
+      onSet = undefined;
+      store(o, 101);
+      store(o, 102);
+      if (opts.path !== 'any') expectPath(p100, opts.path || 'runtime');
+      return desc(o) + ' ' + desc(sibling) + ' effect calls ' + effect_calls;
+    });
+  }
+)";
+
+void SetUpDeclinedStoreTest(v8::Isolate* isolate, Local<Context> context) {
+  i::v8_flags.allow_natives_syntax = true;
+  declined_store_setter_calls = 0;
+  declined_store_past_interceptor_calls = 0;
+  isolate->SetCounterFunction(LookupDeclinedStoreCounter);
+  AddDeclinedStoreConstructor(isolate, context, "T",
+                              v8::PropertyHandlerFlags::kNone);
+  AddDeclinedStoreConstructor(isolate, context, "TNonMasking",
+                              v8::PropertyHandlerFlags::kNonMasking);
+  AddDeclinedStoreConstructor(isolate, context, "TStringsOnly",
+                              v8::PropertyHandlerFlags::kOnlyInterceptStrings);
+  AddDeclinedStoreConstructor(isolate, context, "TWithGetter",
+                              v8::PropertyHandlerFlags::kNone, true);
+  AddDeclinedStoreConstructor(isolate, context, "TAccessChecked",
+                              v8::PropertyHandlerFlags::kNone, false, true);
+  Local<Object> global = context->Global();
+  global
+      ->Set(context, v8_str("calls"),
+            FunctionTemplate::New(isolate, DeclinedStoreSetterCalls)
+                ->GetFunction(context)
+                .ToLocalChecked())
+      .FromJust();
+  const std::pair<const char*, v8::FunctionCallback> natives[] = {
+      {"isInobject", DeclinedStoreIsInobject},
+      {"storePath", DeclinedStorePath},
+      {"pastInterceptorCalls", DeclinedStorePastInterceptorCalls},
+      {"fastPathEnabled", DeclinedStoreFastPathEnabled},
+      {"useIC", DeclinedStoreUseIC},
+      {"gcStress", DeclinedStoreGCStress},
+      {"gc", DeclinedStoreGC},
+  };
+  for (const auto& [name, callback] : natives) {
+    global
+        ->Set(context, v8_str(name),
+              FunctionTemplate::New(isolate, callback)
+                  ->GetFunction(context)
+                  .ToLocalChecked())
+        .FromJust();
+  }
+  CompileRun(kDeclinedStorePrelude);
+}
+
+void RunDeclinedStoreScript(v8::Isolate* isolate, const char* source) {
+  v8::TryCatch try_catch(isolate);
+  CompileRun(source);
+  if (try_catch.HasCaught()) {
+    v8::String::Utf8Value message(isolate, try_catch.Exception());
+    FATAL("%s", *message);
+  }
+}
