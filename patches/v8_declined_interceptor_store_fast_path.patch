+TEST(DeclinedInterceptorStoreCallbackSideEffects) {
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  SetUpDeclinedStoreTest(isolate, env.local());
+  RunDeclinedStoreScript(isolate, R"(
+    withEffect('delete', o => { delete o.x; });
+    withEffect('delete first', o => { delete o.x; },
+               {keys: {x: 0, w_delete_first: 0}});
+    withEffect('delete and re-add', o => { delete o.x; o.x = 5; });
+    withEffect('add another property', o => { o.z = 1; });
+    withEffect('normalize', o => { delete o.w_normalize; },
+               {keys: {w_normalize: 0, x: 0}});
+    withEffect('read-only sloppy',
+               o => { Object.defineProperty(o, 'x', {writable: false}); });
+    withEffect('read-only strict',
+               o => { Object.defineProperty(o, 'x', {writable: false}); },
+               {strict: true});
+    withEffect('accessor', o => {
+      Object.defineProperty(o, 'x', {
+        get() { return 'g'; },
+        set(v) { log.push('accessor:' + v); },
+        configurable: true
+      });
+    });
+    withEffect('freeze sloppy', o => { Object.freeze(o); }, {path: 'any'});
+    withEffect('freeze strict', o => { Object.freeze(o); },
+               {strict: true, path: 'any'});
+    withEffect('seal', o => { Object.seal(o); }, {path: 'any'});
+    withEffect('prevent extensions', o => { Object.preventExtensions(o); },
+               {path: 'any'});
+    withEffect('change prototype', o => { Object.setPrototypeOf(o, {}); });
+    withEffect('prototype with setter', o => {
+      Object.setPrototypeOf(o, {set x(v) { log.push('proto setter'); }});
+    });
+    withEffect('prototype away and back', o => {
+      const proto = Object.getPrototypeOf(o);
+      Object.setPrototypeOf(o, {});
+      Object.setPrototypeOf(o, proto);
+    }, {path: 'any'});
+    withEffect('deprecate map via sibling',
+               (o, sibling) => { sibling.x = 1.5; });
+    withEffect('generalize field type via sibling',
+               (o, sibling) => { sibling.x = 'str'; }, {path: 'fast'});
+    withEffect('throw', o => { throw 'boom'; }, {path: 'any'});
+    withEffect('write itself', o => { o.x = 7; }, {path: 'fast'});
+    withEffect('write itself then delete', o => { o.x = 7; delete o.x; });
+    withEffect('used as prototype', o => { Object.create(o); });
+  )");
+}
