+void DeclinedStoreGC(const v8::FunctionCallbackInfo<Value>& info) {
+  i::Heap* heap = CcTest::heap();
+  v8::String::Utf8Value kind(info.GetIsolate(), info[1]);
+  if (strcmp(*kind, "minor") == 0) {
+    i::heap::InvokeMinorGC(heap);
+    return;
+  }
+  if (strcmp(*kind, "compact") == 0) {
+    i::Handle<i::JSObject> object =
+        i::Cast<i::JSObject>(v8::Utils::OpenHandle(*info[0].As<Object>()));
+    // Promote first, so that the objects are on old-space pages.
+    i::heap::InvokeMajorGC(heap);
+    i::heap::ForceEvacuationCandidate(i::NormalPage::FromHeapObject(*object));
+    if (object->HasFastProperties() &&
+        object->property_array() !=
+            i::ReadOnlyRoots(CcTest::heap()).empty_property_array()) {
+      i::heap::ForceEvacuationCandidate(
+          i::NormalPage::FromHeapObject(object->property_array()));
+    }
+  }
+  i::heap::InvokeMajorGC(heap);
