+TEST(DeclinedInterceptorStoreExclusions) {
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  SetUpDeclinedStoreTest(isolate, env.local());
+  RunDeclinedStoreScript(isolate, R"(
+    compare('non-masking', ({set}) => {
+      const shape = () => make({n1: 0, x: 0}, TNonMasking);
+      warm(set, shape, i => i, 0);
+      const o = shape();
+      for (let i = 0; i < 5; i++) set(o, i, 0);
+      set(make({n1: 0}, TNonMasking), 1, 1);
+      return desc(o);
+    });
+    compare('symbol with kOnlyInterceptStrings', ({kset}) => {
+      const sym = Symbol.for('s');
+      const shape = () => { const o = new TStringsOnly(); o[sym] = 0; return o; };
+      for (let i = 0; i < 12; i++) kset(shape(), i, 0, sym);
+      const o = shape();
+      for (let i = 0; i < 5; i++) kset(o, i, 0, sym);
+      return String(o[sym]);
+    });
+    compare('symbol', ({kset}) => {
+      const sym = Symbol.for('s');
+      const shape = () => { const o = new T(); o[sym] = 0; return o; };
+      for (let i = 0; i < 12; i++) kset(shape(), i, 1, sym);
+      const o = shape();
+      for (let i = 0; i < 5; i++) expectPath(kset(o, i, 1, sym), 'fast');
+      return desc(o);
+    });
+    compare('class fields', ({set}) => {
+      class F extends T { x = 1; y = 2; }
+      const before = calls();
+      const objects = [];
+      for (let i = 0; i < 12; i++) objects.push(new F());
+      log.push('define calls ' + (calls() - before));
+      for (const o of objects) set(o, 5);
+      return desc(objects[11]);
+    });
+    compare('access checked', ({set}) => {
+      const shape = () => make({a1: 0, x: 0}, TAccessChecked);
+      warm(set, shape);
+      const o = shape();
+      for (let i = 0; i < 5; i++) expectPath(set(o, i), 'slow');
+      return String(o.x);
+    });
+    compare('interceptor on the prototype', ({set}) => {
+      const proto = new TWithGetter();
+      const shape = () => Object.create(proto);
+      warm(set, shape, i => i, 0);
+      const o = shape();
+      for (let i = 0; i < 5; i++) set(o, i, 0);
+      // Reflect.set and the IC miss add the property through different
+      // paths, so only the observable values are compared.
+      return JSON.stringify(Object.getOwnPropertyNames(o)) + o.x;
+    });
+    compare('dictionary mode', ({set}) => {
+      const shape = () => {
+        const o = make({d1: 0, d2: 0, x: 0});
+        delete o.d1;
+        return o;
+      };
+      warm(set, shape);
+      const o = shape();
+      check(!%HasFastProperties(o), 'dictionary');
+      for (let i = 0; i < 5; i++) expectPath(set(o, i), 'runtime');
+      return desc(o);
+    });
+    compare('add a missing property', ({set}) => {
+      const shape = () => make({a2: 0});
+      warm(set, shape);
+      const objects = [];
+      for (let i = 0; i < 5; i++) {
+        const o = shape();
+        expectPath(set(o, i), 'runtime');
+        objects.push(o);
+      }
+      return objects.map(desc).join(' ');
+    });
+    for (const name of ['constructor', 'then', 'next', 'valueOf']) {
+      compare('protector name ' + name, ({kset}) => {
+        const shape = () => make({p0: 0, [name]: 0});
+        for (let i = 0; i < 12; i++) kset(shape(), i, 1, name);
+        const o = shape();
+        for (let i = 0; i < 5; i++) expectPath(kset(o, i, 1, name), 'slow');
+        return desc(o);
+      });
+    }
+  )");
+}
