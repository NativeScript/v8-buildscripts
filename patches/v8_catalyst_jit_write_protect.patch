diff --git a/src/base/platform/platform-darwin.cc b/src/base/platform/platform-darwin.cc
index 41fc5ec3302..004ae7c002b 100644
--- a/src/base/platform/platform-darwin.cc
+++ b/src/base/platform/platform-darwin.cc
@@ -234,6 +234,24 @@ V8_BASE_EXPORT void SetJitWriteProtected(int enable) {
 }
 
 #pragma clang diagnostic pop
+#elif V8_HAS_PTHREAD_JIT_WRITE_PROTECT && defined(V8_OS_MACCATALYST)
+// The SDK marks pthread_jit_write_protect_np unavailable on Mac Catalyst, but
+// a Catalyst process runs against macOS's libpthread, which exports it.
+namespace {
+using JitWriteProtectFn = void (*)(int);
+
+JitWriteProtectFn ResolveJitWriteProtect() {
+  auto fn = reinterpret_cast<JitWriteProtectFn>(
+      dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_np"));
+  CHECK_NOT_NULL(fn);
+  return fn;
+}
+}  // namespace
+
+V8_BASE_EXPORT void SetJitWriteProtected(int enable) {
+  static const JitWriteProtectFn jit_write_protect = ResolveJitWriteProtect();
+  jit_write_protect(enable);
+}
 #endif
 
 }  // namespace base
