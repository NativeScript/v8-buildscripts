+    if (semantics == EnforceDefineSemantics::kDefine &&
+        object->map()->has_named_interceptor()) {
+      // Neither the transition fast path nor the checks below call the
+      // interceptor. As in [[DefineOwnProperty]], its definer goes first, and
+      // the checks run only if it declines.
+      LookupIterator it(isolate, object, key, LookupIterator::OWN);
+      while (it.state() == LookupIterator::ACCESS_CHECK && it.HasAccess()) {
+        it.Next();
+      }
+      if (it.state() == LookupIterator::INTERCEPTOR) {
+        return DefineOwnPropertyIgnoreAttributes(
+            &it, value, NONE, should_throw, DONT_FORCE_FIELD,
+            EnforceDefineSemantics::kDefine);
+      }
+    } else if (TryFastAddDataProperty(isolate, object, key.name(), value,
+                                      NONE)) {
       return Just(true);
     }
   }
