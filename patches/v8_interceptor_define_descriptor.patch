+// Check that a class field reaches the callback as a plain data property.
+namespace {
+int data_property_define_calls = 0;
+v8::Intercepted CheckDataPropertyDefineCallback(
+    Local<Name> name, const v8::PropertyDescriptor& desc,
+    const v8::PropertyCallbackInfo<Boolean>& info) {
+  data_property_define_calls++;
+  CHECK(desc.has_value());
+  CHECK_EQ(42, desc.value()
+                   ->Int32Value(info.GetIsolate()->GetCurrentContext())
+                   .FromJust());
+  CHECK(desc.has_writable());
+  CHECK(desc.writable());
+  CHECK(desc.has_enumerable());
+  CHECK(desc.enumerable());
+  CHECK(desc.has_configurable());
+  CHECK(desc.configurable());
+  CHECK(!desc.has_get());
+  CHECK(!desc.has_set());
+  return v8::Intercepted::kYes;
+}
+}  // namespace
+
+THREADED_TEST(PropertyDefinerCallbackClassField) {
+  v8::HandleScope scope(CcTest::isolate());
+  LocalContext env;
+  v8::Local<v8::FunctionTemplate> templ =
+      v8::FunctionTemplate::New(CcTest::isolate());
+  templ->InstanceTemplate()->SetHandler(v8::NamedPropertyHandlerConfiguration(
+      nullptr, nullptr, nullptr, nullptr, nullptr,
+      CheckDataPropertyDefineCallback));
+  env->Global()
+      ->Set(env.local(), v8_str("Cls"),
+            templ->GetFunction(env.local()).ToLocalChecked())
+      .FromJust();
+  data_property_define_calls = 0;
+  const char* code =
+      "class WithField extends Cls { x = 42; }"
+      "new WithField().x;";
+  CHECK(v8_compile(code)->Run(env.local()).ToLocalChecked()->IsUndefined());
+  CHECK_EQ(1, data_property_define_calls);
+}
+
